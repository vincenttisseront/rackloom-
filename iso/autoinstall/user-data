#cloud-config
# Graine bootstrap Rackloom (ADR-0004 / RAC-61).
#
# Ce que voit l'opérateur :
#   - Menu GRUB Rackloom (« Install Rackloom appliance »)
#   - Installateur console Rackloom (early-commands) : réseau, hostname,
#     mot de passe compte initial, confirmation explicite du disque
#
# Ce qu'il ne voit PAS :
#   - Aucun écran Subiquity stock (language, keyboard, mirror, source,
#     updates, SSH, snaps, Ubuntu Pro, etc.)
#
# Sous le capot : live-server Ubuntu 24.04 + Subiquity/curtin appliquent
# la graine réécrite (100 % non interactive) par iso/installer/run.sh.
#
# Aucun secret, mot de passe applicatif ou certificat privé n'est embarqué.
autoinstall:
  version: 1
  early-commands:
    # UI console Rackloom ; réécrit /autoinstall.yaml sans interactive-sections.
    # bash explicite : le bit +x n'est pas toujours honoré sur ISO 9660.
    - bash /cdrom/rackloom/installer/run.sh
  # Stubs volontairement inutilisables si l'installateur n'a pas tourné
  # (échec fail-closed : pas d'effacement silencieux).
  locale: fr_FR.UTF-8
  keyboard:
    layout: fr
    variant: ""
  timezone: Etc/UTC
  refresh-installer:
    update: false
  identity:
    hostname: rackloom
    username: rackloom
    # Placeholder : remplacé par le hash saisi dans l'installateur console.
    password: "$6$rackloom$InstallerMustReplaceThisPlaceholderHashValueXXXX"
  storage:
    layout:
      name: lvm
      match:
        path: /dev/disk/by-id/rackloom-installer-must-select-disk
  ssh:
    install-server: true
    allow-pw: false
  packages:
    - qemu-guest-agent
    - curl
    - ca-certificates
    - openssl
  apt:
    preserve_sources_list: false
    fallback: offline-install
  snaps: []
  late-commands:
    - /cdrom/rackloom/install-debs.sh
    - curtin in-target -- mkdir -p /opt/rackloom /etc/rackloom /var/lib/rackloom
    - curtin in-target -- mkdir -p /etc/rackloom/secrets /etc/rackloom/keys /etc/rackloom/tls
    - cp -a /cdrom/rackloom/payload/. /target/
    - curtin in-target -- chmod 0755 /usr/local/sbin/rackloom-firstboot /usr/local/lib/rackloom/*.sh
    - curtin in-target -- chmod 0644 /lib/systemd/system/rackloom.service /lib/systemd/system/rackloom-firstboot.service
    - curtin in-target -- systemctl enable docker.service
    - curtin in-target -- systemctl enable rackloom-firstboot.service
    - curtin in-target -- systemctl enable rackloom.service
    - curtin in-target -- usermod -aG docker rackloom || true
  shutdown: reboot
