# Versions figées pour la construction de l'ISO appliance (Lot 3 / ADR-0004).
# Ne pas modifier sans recalculer le SHA-256 et revalider la signature GPG amont.

UBUNTU_CODENAME=noble
UBUNTU_RELEASE=24.04
UBUNTU_ISO_VERSION=24.04.5
UBUNTU_ISO_NAME=ubuntu-${UBUNTU_ISO_VERSION}-live-server-amd64.iso
UBUNTU_ISO_URL=https://releases.ubuntu.com/${UBUNTU_RELEASE}/${UBUNTU_ISO_NAME}
UBUNTU_SHA256SUMS_URL=https://releases.ubuntu.com/${UBUNTU_RELEASE}/SHA256SUMS
UBUNTU_SHA256SUMS_GPG_URL=https://releases.ubuntu.com/${UBUNTU_RELEASE}/SHA256SUMS.gpg
# Empreinte de la clé « Ubuntu CD Image Automatic Signing Key (2012) »
UBUNTU_CD_SIGNING_KEY=843938DF228D22F7B3742BC0D94AA3F0EFE21092

# Étiquette des images embarquées (empreintes enregistrées dans le manifeste à la construction).
RACKLOOM_IMAGE_TAG=appliance
