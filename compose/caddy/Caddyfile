{
	admin off
	local_certs
	skip_install_trust
	auto_https disable_redirects
	servers {
		trusted_proxies static private_ranges
	}
}

https://localhost:8443 {
	tls internal
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
	# En-tête CSP généré à la construction (web/scripts/csp.mjs) : scripts en ligne de Nuxt autorisés par empreinte.
	import /etc/caddy/csp.caddy

	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	# Lot 4 : IdP OIDC local (Dex). Issuer public https://localhost:8443/dex.
	handle /dex* {
		reverse_proxy dex:5556 {
			header_up X-Forwarded-Proto {http.request.scheme}
			header_up X-Forwarded-Host {http.request.host}
		}
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
